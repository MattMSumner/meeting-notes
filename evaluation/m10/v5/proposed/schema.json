{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "commitment_id": {
          "description": "Transcript source ID, never task prose or a date",
          "title": "Commitment Id",
          "type": "string"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ]
        },
        "timing_context": {
          "description": "Other transcript IDs clarifying timing; omit the commitment itself",
          "items": {
            "type": "string"
          },
          "title": "Timing Context",
          "type": "array"
        }
      },
      "required": [
        "commitment_id",
        "timing",
        "timing_context"
      ],
      "title": "Action",
      "type": "object"
    },
    "Dispute": {
      "additionalProperties": false,
      "properties": {
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "transcript": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Transcript",
          "type": "array"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "topic",
        "transcript",
        "notes"
      ],
      "title": "Dispute",
      "type": "object"
    },
    "SupportedText": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "text",
        "sources"
      ],
      "title": "SupportedText",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "description": "Transcript source ID containing the exact timing quote",
          "title": "Source Id",
          "type": "string"
        },
        "quote": {
          "description": "Exact timing phrase from source_id",
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "quote"
      ],
      "title": "Timing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "overview": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Overview",
      "type": "array"
    },
    "key_points": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Key Points",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Decisions",
      "type": "array"
    },
    "action_items": {
      "items": {
        "$ref": "#/$defs/Action"
      },
      "title": "Action Items",
      "type": "array"
    },
    "notes_context": {
      "items": {
        "$ref": "#/$defs/SupportedText"
      },
      "title": "Notes Context",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/Dispute"
      },
      "title": "Conflicts",
      "type": "array"
    }
  },
  "required": [
    "overview",
    "key_points",
    "decisions",
    "action_items",
    "notes_context",
    "conflicts"
  ],
  "title": "Draft",
  "type": "object"
}
