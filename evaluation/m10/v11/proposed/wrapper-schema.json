          "type": "string"
        },
        "occurrence": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One-based literal occurrence; required for repeated text",
          "title": "Occurrence"
        },
        "kind": {
          "enum": [
            "fact",
            "commitment",
            "context",
            "request"
