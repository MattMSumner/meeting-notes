    "Summary": {
      "additionalProperties": false,
      "properties": {
        "overview": {
          "description": "Two or three sentences about the meeting. Describe disputed topics as unresolved and refer to Conflicts; do not repeat a disputed value as settled.",
          "title": "Overview",
          "type": "string"
        },
        "key_points": {
          "description": "Important spoken points. For disputed topics, state that the sources disagree and refer to Conflicts instead of repeating one disputed value as fact.",
