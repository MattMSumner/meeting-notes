{
  "$defs": {
    "ActionItem": {
      "additionalProperties": false,
      "properties": {
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who will do it: a name, \"Them\" if no name was given, or null if unclear",
          "title": "Owner"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "review": {
          "items": {
            "type": "string"
          },
          "title": "Review",
          "type": "array"
        },
        "due": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete spoken timing phrase, including every alternative, condition and uncertainty. Must stand on its own even if task repeats the timing. Preserve relative wording; null when no timing was spoken.",
          "title": "Due"
        }
      },
      "required": [
        "owner",
        "task",
        "due"
      ],
      "title": "ActionItem",
      "type": "object"
    },
    "Attempt": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "additionalProperties": true,
          "title": "Request",
          "type": "object"
        },
        "reply": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply"
        },
        "response": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "blocking": {
          "items": {
            "type": "string"
          },
          "title": "Blocking",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "request"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "Audit": {
      "additionalProperties": false,
